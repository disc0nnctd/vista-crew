        </mxCell>
        <mxCell id="query" value="&lt;b&gt;aircrew/query.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;Filtered records, profiles and derived lookup fields" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#548466;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
