  <diagram id="contracts" name="03 Tools, data and verification">
    <mxGraphModel dx="1720" dy="1190" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1190" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Tool surface | contracts and deterministic dependencies" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=28;fontColor=#243342;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1640" height="42" />
        </mxCell>
        <mxCell id="subtitle" value="Ten tools consolidate record joins. The model chooses questions; Python performs the implemented calculations and checks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#536477;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="73" width="1640" height="34" />
        </mxCell>
        <mxCell id="callers" value="&lt;b&gt;Callers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Agent tool calls&lt;br&gt;POST /api/tool&lt;br&gt;CLI deterministic operations" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#527aa5;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="145" width="365" height="130" />
        </mxCell>
        <mxCell id="dispatch" value="&lt;b&gt;Tools / dispatch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Normalize empty arguments; route by name&lt;br&gt;Return error envelopes for invalid calls&lt;br&gt;Shared Query, Engine and Dataset objects" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#548466;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="505" y="145" width="490" height="130" />
        </mxCell>
        <mxCell id="envelope" value="&lt;b&gt;Result envelope&lt;/b&gt;&lt;br&gt;&lt;br&gt;summary: human-readable result scope&lt;br&gt;claims[]: id, kind, text, short, value, basis&lt;br&gt;missing[]: what this result does not establish&lt;br&gt;data: structured computation / lookup output&lt;br&gt;&lt;br&gt;Agent renumbers claim IDs within each turn.&lt;br&gt;The browser uses structured results for its panels." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2d8;strokeColor=#ad8237;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1110" y="145" width="555" height="250" />
        </mxCell>
        <mxCell id="lookups" value="&lt;b&gt;Facts and context&lt;/b&gt;&lt;br&gt;&lt;br&gt;lookup(entity, filters)&lt;br&gt;crew_profile(crew_id, on_date)&lt;br&gt;&lt;br&gt;Flights, crew, pairings, reserves,&lt;br&gt;certificates, risk and network stations" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#548466;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="370" width="365" height="200" />
        </mxCell>
        <mxCell id="checks" value="&lt;b&gt;Checks and impact&lt;/b&gt;&lt;br&gt;&lt;br&gt;trace_disruption&lt;br&gt;check_assignment&lt;br&gt;duty_timeline&lt;br&gt;earliest_next_report&lt;br&gt;validate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#548466;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="630" width="365" height="200" />
        </mxCell>
        <mxCell id="plans" value="&lt;b&gt;Recovery and draft messages&lt;/b&gt;&lt;br&gt;&lt;br&gt;simulate_disruption&lt;br&gt;resolve_cover (one or multiple vacancies)&lt;br&gt;draft_notification" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#548466;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
