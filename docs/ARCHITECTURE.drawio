  <diagram id="turn" name="02 Chat turn and claim gate">
    <mxGraphModel dx="1760" dy="1270" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1270" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Chat turn | tool loop, correction and delivery" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=28;fontColor=#243342;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1680" height="42" />
        </mxCell>
        <mxCell id="subtitle" value="The current agent has one corrective phase with multiple possible tool rounds. Outcome branches use Grounding.ok and Grounding.blocking." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=14;fontColor=#536477;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="73" width="1680" height="34" />
        </mxCell>
        <mxCell id="request" value="&lt;b&gt;POST /api/chat&lt;/b&gt;&lt;br&gt;&lt;br&gt;Message + X-Desk-Session&lt;br&gt;Fallback: session cookie / default desk" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#527aa5;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="155" width="285" height="110" />
        </mxCell>
        <mxCell id="session" value="&lt;b&gt;Resolve desk and acquire its lock&lt;/b&gt;&lt;br&gt;&lt;br&gt;Per-desk message history&lt;br&gt;Append user question" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#527aa5;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="415" y="155" width="330" height="110" />
        </mxCell>
        <mxCell id="complete" value="&lt;b&gt;Model completion&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prompt + history + tool schemas&lt;br&gt;tool_choice = auto" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eeeafb;strokeColor=#76619d;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="835" y="155" width="340" height="110" />
        </mxCell>
        <mxCell id="hascalls" value="&lt;b&gt;Tool calls?&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eeeafb;strokeColor=#76619d;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=middle;spacing=16;shape=rhombus;align=center;;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="345" width="250" height="120" />
        </mxCell>
        <mxCell id="dispatch" value="&lt;b&gt;Execute tool calls&lt;/b&gt;&lt;br&gt;&lt;br&gt;Parse arguments; dispatch each call&lt;br&gt;Append results; renumber all claims&lt;br&gt;Append tool messages to history" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#548466;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1330" y="335" width="355" height="150" />
        </mxCell>
        <mxCell id="gate1" value="&lt;b&gt;Grounding.check(draft, results)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Substitute full / short claim text&lt;br&gt;Check IDs, numbers, times, units,&lt;br&gt;subjects and verdict contradictions&lt;br&gt;Also flag style faults" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2d8;strokeColor=#ad8237;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="835" y="555" width="340" height="150" />
        </mxCell>
        <mxCell id="ok1" value="&lt;b&gt;ok = true?&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2d8;strokeColor=#ad8237;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=middle;spacing=16;shape=rhombus;align=center;;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="790" width="250" height="115" />
        </mxCell>
        <mxCell id="correction" value="&lt;b&gt;One corrective phase&lt;/b&gt;&lt;br&gt;&lt;br&gt;Append corrective instruction&lt;br&gt;Allow up to max_rounds completions&lt;br&gt;Tools may run again; add their results&lt;br&gt;Final completion requests no tools" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eeeafb;strokeColor=#76619d;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="415" y="780" width="335" height="165" />
        </mxCell>
        <mxCell id="gate2" value="&lt;b&gt;Check revised draft&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use accumulated turn results&lt;br&gt;Inspect ok and blocking" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2d8;strokeColor=#ad8237;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="785" width="285" height="145" />
        </mxCell>
        <mxCell id="accept" value="&lt;b&gt;Return rendered reply&lt;/b&gt;&lt;br&gt;&lt;br&gt;Initial check passed; corrected = false" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#548466;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1290" y="795" width="390" height="105" />
        </mxCell>
        <mxCell id="accepted2" value="&lt;b&gt;Revised reply accepted&lt;/b&gt;&lt;br&gt;&lt;br&gt;ok = true OR blocking = false&lt;br&gt;Return rendered text; corrected = true&lt;br&gt;Nonblocking style faults can remain" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#548466;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1035" width="475" height="115" />
        </mxCell>
        <mxCell id="withheld" value="&lt;b&gt;Revised reply withheld&lt;/b&gt;&lt;br&gt;&lt;br&gt;blocking = true&lt;br&gt;Return fixed refusal; corrected = true&lt;br&gt;Preserve computed results for the workspace" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2d8;strokeColor=#ad8237;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="625" y="1035" width="475" height="115" />
        </mxCell>
        <mxCell id="response" value="&lt;b&gt;HTTP response to browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;reply, tool_calls, tool_results&lt;br&gt;corrected, grounded, ungrounded_numbers&lt;br&gt;Chat renders reply; workspace selects&lt;br&gt;and renders relevant tool data" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#527aa5;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1290" y="1035" width="390" height="150" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;Loop bounds and transport&lt;/b&gt;&lt;br&gt;&lt;br&gt;Default max_rounds = 8; tool-only exhaustion proceeds to grounding with a fixed status message.&lt;br&gt;Model transport uses urllib with timeout and retries.&lt;br&gt;Missing model configuration: HTTP 503. Unhandled model-call failure: HTTP 502." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b6c0ca;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
