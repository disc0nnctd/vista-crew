        <mxCell id="rules" value="&lt;b&gt;aircrew/rules.py | seven roster rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;FDP-01: flight duty period; DUTY-02: 7-day duty&lt;br&gt;FLT-03: 28-day flight hours; REST-04: minimum rest&lt;br&gt;QUAL-05: aircraft rating; CERT-06: certification&lt;br&gt;BASE-07: base / positioning; callability separately exposed" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#548466;strokeWidth=1.5;fontColor=#243342;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
